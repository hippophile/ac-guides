GITHUB_TOKEN=ghp_your_github_token_here
# GitHub Models available via: https://models.inference.ai.azure.com
# Models included free with GitHub Copilot Pro:
#   gpt-4o, gpt-4o-mini, claude-3.5-sonnet, meta-llama-3.1-70b-instruct,
#   mistral-large, phi-4, cohere-command-r-plus, and more
# See full list: https://github.com/marketplace/models

GEMINI_API_KEY=your_gemini_api_key_here
# Get free key at: https://aistudio.google.com/apikey
# Free tier: 1,500 req/day (Gemini 1.5 Flash), 50 req/day (Gemini 1.5 Pro)
# OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai/

NVIDIA_API_KEY=nvapi-your_nvidia_key_here
# Get free key at: https://build.nvidia.com
# Free tier: 1,000 credits on signup, then pay-as-you-go
# OpenAI-compatible endpoint: https://integrate.api.nvidia.com/v1
# Models: llama-3.1-70b, mistral-7b, mixtral-8x22b, phi-3-medium, and more
# See full list: https://catalog.ngc.nvidia.com/ai-foundation-models

# Azure OpenAI (if the bank has an enterprise subscription)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Azure AI Search (if using Azure for RAG)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your_search_key_here
