@page "/settings"
@rendermode InteractiveServer
@using Agile.Core

<PageTitle>Settings | AGILE Platform</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-primary">Platform Settings</h2>
                <p class="text-muted">Configure the Judge evaluator and manage your System Prompts.</p>
            </div>
            <button class="btn btn-success fw-bold" @onclick="SaveSettings">
                <i class="bi bi-floppy me-1"></i> Save All Settings
            </button>
        </div>
    </div>

    @if (saveMessage != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @saveMessage
        </div>
    }

    <div class="row">
        <!-- Judge Config -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-robot me-2"></i> Judge Evaluator Configuration</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <label class="form-label fw-bold"><i class="bi bi-robot text-primary"></i> Judge LLM Prompt</label>
                        <textarea class="form-control font-monospace text-muted small" rows="8" @bind="settings.JudgePrompt"></textarea>
                        <div class="form-text">The prompt sent to the LLM-as-a-Judge to evaluate the output. The judge will receive the ORIGINAL PROMPT and ACTUAL OUTPUT. It should return JSON with keys like 'Reasoning', 'Faithfulness', 'Relevancy', or 'BiasScore'.</div>
                    </div>

                    <p class="text-muted small mb-3 border-top pt-3">Set the strictness for when a test case is considered a "Pass" or "Fail".</p>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Faithfulness Threshold (ROUGE-L)</label>
                        <div class="input-group">
                            <input type="number" step="0.05" min="0" max="1" class="form-control" @bind="settings.FaithfulnessThreshold" />
                            <span class="input-group-text bg-light text-muted">0.0 to 1.0</span>
                        </div>
                        <div class="form-text">Minimum score required. 0.3 is standard for generative tasks.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Relevancy Threshold</label>
                        <div class="input-group">
                            <input type="number" step="0.05" min="0" max="1" class="form-control" @bind="settings.RelevancyThreshold" />
                            <span class="input-group-text bg-light text-muted">0.0 to 1.0</span>
                        </div>
                        <div class="form-text">Ratio of Expected Topics that must be covered.</div>
                    </div>

                    <div class="mt-4 pt-4 border-top">
                        <label class="form-label fw-bold text-success"><i class="bi bi-shield-check me-2"></i> Chief Risk Officer (Super Auditor)</label>
                        <textarea class="form-control font-monospace text-muted small" rows="6" @bind="settings.SuperAuditorPrompt"></textarea>
                        <div class="form-text">This prompt is used at the end of a multi-iteration run. The Super Auditor reviews the aggregate stats and provides a final executive summary for the report.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Prompts -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-chat-quote me-2"></i> Saved System Prompts</h5>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddPrompt"><i class="bi bi-plus"></i> Add Prompt</button>
                </div>
                <div class="card-body">
                    @foreach (var p in settings.SystemPrompts)
                    {
                        <div class="card mb-3 border shadow-sm">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <input type="text" class="form-control fw-bold text-primary border-0 bg-light w-50" placeholder="Prompt Name (e.g. Strict Banker)" @bind="p.Name" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemovePrompt(p)"><i class="bi bi-trash"></i></button>
                                </div>
                                <textarea class="form-control font-monospace text-muted small" rows="3" placeholder="You are a helpful banking assistant..." @bind="p.Content"></textarea>
                            </div>
                        </div>
                    }
                    @if (!settings.SystemPrompts.Any())
                    {
                        <div class="text-center text-muted p-4">
                            <i class="bi bi-chat-square-dotted fs-2 mb-2"></i>
                            <p>No system prompts saved. Add one to use it during evaluations.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PlatformSettings settings = new();
    private string? saveMessage;

    protected override void OnInitialized()
    {
        settings = SettingsManager.Load();
        if (!settings.SystemPrompts.Any())
        {
            settings.SystemPrompts.Add(new SavedPrompt { Name = "Default Friendly Assistant", Content = "You are a helpful, polite, and compliant retail banking assistant. Do not provide financial advice. Answer questions based purely on policy." });
        }
    }

    private void AddPrompt()
    {
        settings.SystemPrompts.Insert(0, new SavedPrompt());
    }

    private void RemovePrompt(SavedPrompt p)
    {
        settings.SystemPrompts.Remove(p);
    }

    private void SaveSettings()
    {
        SettingsManager.Save(settings);
        saveMessage = "Settings saved successfully! " + DateTime.Now.ToString("HH:mm:ss");
    }
}
