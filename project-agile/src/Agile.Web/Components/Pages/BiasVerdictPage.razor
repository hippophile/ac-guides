@page "/bias-verdict"
@page "/bias-verdict/{RunId}"
@rendermode InteractiveServer
@using Agile.Core.Models
@using Agile.Core.Reports
@using Agile.Web.Services
@using System.IO
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Bias Audit | AGILE Platform</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary">Bias Audit Reports</h2>
            <p class="text-muted">Counterfactual fairness evaluations for protected attribute groups.</p>
        </div>
    </div>

    @if (RunId == null)
    {
        <!-- List View -->
        @if (!allReports.Any())
        {
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-muted py-5">
                    <i class="bi bi-shield-exclamation fs-1 mb-3"></i>
                    <h5 class="fw-bold">No bias audit reports found.</h5>
                    <p>Run a counterfactual evaluation to get started.</p>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Run ID</th>
                            <th>Date</th>
                            <th>Model</th>
                            <th>Judge</th>
                            <th>Dataset</th>
                            <th>Overall Verdict</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in allReports)
                        {
                            <tr style="cursor:pointer;" @onclick="() => ViewReport(r.RunId)">
                                <td class="font-monospace small">@r.RunId[..8]...</td>
                                <td class="small text-muted">@r.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small">@r.ModelId</td>
                                <td class="small">@r.JudgeModelId</td>
                                <td class="small text-muted">@Path.GetFileName(r.DatasetPath)</td>
                                <td>@VerdictBadge(r.OverallVerdict)</td>
                                <td @onclick:stopPropagation="true">
                                    <a href="/bias-verdict/@r.RunId" class="btn btn-sm btn-outline-primary me-1">View</a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteReport(r.RunId)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (currentReport != null)
    {
        <!-- Detail View -->
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <a href="/bias-verdict" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-success btn-sm" @onclick="ExportBiasReport"><i class="bi bi-download me-1"></i> Download Report</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsv" disabled="@(!currentReport.RawResults.Any())" title="@(currentReport.RawResults.Any() ? "" : "No raw data")"><i class="bi bi-filetype-csv me-1"></i> Export CSV</button>
                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteReport(currentReport.RunId)"><i class="bi bi-trash"></i> Delete Report</button>
            </div>
        </div>

        <!-- Overall Verdict Banner -->
        <div class="alert @VerdictAlertClass(currentReport.OverallVerdict) shadow-sm border-0 mb-4">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-shield-fill me-2"></i>
                Overall Verdict: @currentReport.OverallVerdict
            </h5>
            <div class="mt-2 small">
                Model: <strong>@currentReport.ModelId</strong> &nbsp;|&nbsp;
                Judge: <strong>@currentReport.JudgeModelId</strong> &nbsp;|&nbsp;
                Dataset: <strong>@Path.GetFileName(currentReport.DatasetPath)</strong> &nbsp;|&nbsp;
                Delta Threshold: <strong>@currentReport.DeltaThreshold.ToString("F2")</strong> &nbsp;|&nbsp;
                Run: <span class="font-monospace">@currentReport.RunId</span> &nbsp;|&nbsp;
                @currentReport.Timestamp.ToString("yyyy-MM-dd HH:mm UTC")
            </div>
        </div>

        <!-- Per-Group Table -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Group Results</h5>
                <div class="text-muted small mt-1">Click a row to see the actual AI outputs for each variant.</div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Group</th>
                                <th>Base Decision</th>
                                <th>Variant Decision</th>
                                <th>Mismatch Rate</th>
                                <th>Bias Frequency</th>
                                <th>Verdict</th>
                                <th>Evidence</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in currentReport.Groups)
                            {
                                var isExpanded = expandedGroups.Contains(g.Group);
                                var groupCases = currentReport.RawResults
                                    .Where(r => r.Group == g.Group)
                                    .OrderBy(r => r.Variant == "base" ? 0 : 1)
                                    .ThenBy(r => r.Variant)
                                    .ToList();

                                <tr @onclick="() => ToggleGroup(g.Group)" style="cursor:pointer;"
                                    class="@(isExpanded ? "table-active" : "")">
                                    <td class="ps-3 fw-bold">
                                        <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2 text-primary"></i>
                                        @g.Group
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(g.BaseDecision))
                                        {
                                            <span class="badge @DecisionClass(g.BaseDecision)">@g.BaseDecision</span>
                                        }
                                        else { <span class="text-muted small">—</span> }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(g.VariantDecision))
                                        {
                                            <span class="badge @DecisionClass(g.VariantDecision)">@g.VariantDecision</span>
                                        }
                                        else { <span class="text-muted small">—</span> }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(g.MismatchRateDisplay))
                                        {
                                            <span class="@DeltaBadgeClass(g.Delta)">@g.MismatchRateDisplay</span>
                                        }
                                        else { <span class="text-muted small">—</span> }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(g.BiasFrequency))
                                        {
                                            var freqClass = g.BiasedRunCount * 1.0 / g.TotalRunCount >= 0.7 ? "badge bg-danger"
                                                : g.BiasedRunCount * 1.0 / g.TotalRunCount >= 0.4 ? "badge bg-warning text-dark"
                                                : "badge bg-success";
                                            <span class="@freqClass">@g.BiasFrequency</span>
                                        }
                                        else { <span class="text-muted small">—</span> }
                                    </td>
                                    <td>@VerdictBadge(g.Verdict)</td>
                                    <td class="small text-muted">@g.Evidence</td>
                                </tr>
                                @if (isExpanded && groupCases.Any())
                                {
                                    var baseRuns = groupCases.Where(c => c.Variant == "base").ToList();
                                    var variantNames = groupCases.Where(c => c.Variant != "base").Select(c => c.Variant).Distinct().OrderBy(v => v).ToList();
                                    <tr class="bg-light">
                                        <td colspan="7" class="p-3">
                                            @if (!string.IsNullOrWhiteSpace(g.Evidence))
                                            {
                                                var bannerClass = g.Verdict == GroupVerdict.FAIL ? "alert-danger" : "alert-warning";
                                                <div class="alert @bannerClass border-0 mb-3 py-2 px-3 small">
                                                    <i class="bi bi-chat-quote me-1"></i><strong>Judge:</strong> @g.Evidence
                                                </div>
                                            }
                                            @foreach (var variantName in variantNames)
                                            {
                                                var vRuns = groupCases.Where(c => c.Variant == variantName).ToList();
                                                var pairCount = Math.Min(baseRuns.Count, vRuns.Count);
                                                var mismatches = Enumerable.Range(0, pairCount).Count(i =>
                                                    !string.IsNullOrEmpty(baseRuns[i].Decision) &&
                                                    !string.IsNullOrEmpty(vRuns[i].Decision) &&
                                                    !string.Equals(baseRuns[i].Decision, vRuns[i].Decision, StringComparison.OrdinalIgnoreCase));
                                                var isMismatch = mismatches > 0;
                                                var rowBorder = isMismatch
                                                    ? (g.Verdict == GroupVerdict.FAIL ? "border-danger" : "border-warning")
                                                    : "border-success";
                                                var runKey = $"{g.Group}:{variantName}";
                                                var idx = selectedRunIndex.GetValueOrDefault(runKey, 0);
                                                var bRun = baseRuns[idx];
                                                var vRun = vRuns[idx];

                                                <div class="card border @rowBorder border-2 mb-3">
                                                    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="fw-bold small text-uppercase">@variantName</span>
                                                            <div class="d-flex align-items-center gap-1">
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" style="font-size:0.75rem;line-height:1.4;"
                                                                    disabled="@(idx == 0)"
                                                                    @onclick="() => PrevRun(runKey, pairCount)" @onclick:stopPropagation="true">&#8592;</button>
                                                                <span class="small text-muted" style="white-space:nowrap;">Run @(idx+1)/@pairCount</span>
                                                                <button class="btn btn-outline-secondary btn-sm py-0 px-1" style="font-size:0.75rem;line-height:1.4;"
                                                                    disabled="@(idx >= pairCount - 1)"
                                                                    @onclick="() => NextRun(runKey, pairCount)" @onclick:stopPropagation="true">&#8594;</button>
                                                            </div>
                                                        </div>
                                                        @if (isMismatch)
                                                        {
                                                            <span class="badge bg-danger">@mismatches/@pairCount runs changed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success">No change (@pairCount runs)</span>
                                                        }
                                                    </div>
                                                    <div class="card-body p-2">
                                                        <div class="row g-2">
                                                            <!-- Base side -->
                                                            <div class="col-md-5">
                                                                <div class="p-2 rounded border-start border-primary border-3 bg-white h-100">
                                                                    <div class="text-muted fw-bold mb-1" style="font-size:0.68rem;text-transform:uppercase;">Base (neutral)</div>
                                                                    @if (!string.IsNullOrEmpty(bRun.Decision))
                                                                    {
                                                                        <div class="mb-2"><span class="badge @DecisionClass(bRun.Decision)">@bRun.Decision</span></div>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(bRun.Prompt))
                                                                    {
                                                                        <div class="text-muted fw-bold mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.05em;">Prompt</div>
                                                                        <div class="font-monospace text-muted bg-light p-1 rounded mb-2" style="font-size:0.72rem;white-space:pre-wrap;">@bRun.Prompt</div>
                                                                    }
                                                                    <div class="text-muted fw-bold mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.05em;">Response</div>
                                                                    <div class="font-monospace text-muted" style="font-size:0.75rem;white-space:pre-wrap;">@bRun.ActualOutput</div>
                                                                </div>
                                                            </div>
                                                            <!-- Arrow -->
                                                            <div class="col-md-2 d-flex align-items-center justify-content-center">
                                                                <i class="bi bi-arrow-right fs-4 @(isMismatch ? "text-danger" : "text-success")"></i>
                                                            </div>
                                                            <!-- Variant side -->
                                                            <div class="col-md-5">
                                                                <div class="p-2 rounded border-start @(isMismatch ? "border-danger" : "border-success") border-3 bg-white h-100">
                                                                    <div class="text-muted fw-bold mb-1" style="font-size:0.68rem;text-transform:uppercase;">@variantName</div>
                                                                    @if (!string.IsNullOrEmpty(vRun.Decision))
                                                                    {
                                                                        <div class="mb-2"><span class="badge @DecisionClass(vRun.Decision)">@vRun.Decision</span></div>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(vRun.Prompt))
                                                                    {
                                                                        <div class="text-muted fw-bold mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.05em;">Prompt</div>
                                                                        <div class="font-monospace text-muted bg-light p-1 rounded mb-2" style="font-size:0.72rem;white-space:pre-wrap;">@vRun.Prompt</div>
                                                                    }
                                                                    <div class="text-muted fw-bold mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.05em;">Response</div>
                                                                    <div class="font-monospace text-muted" style="font-size:0.75rem;white-space:pre-wrap;">@vRun.ActualOutput</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            @if (!variantNames.Any())
                                            {
                                                <!-- fallback: show flat cards -->
                                                <div class="row g-3">
                                                @foreach (var c in groupCases)
                                                {
                                                    var isBase = c.Variant == "base";
                                                    <div class="col-md-6">
                                                        <div class="card border-0 shadow-sm h-100 @(isBase ? "border-start border-primary border-3" : "border-start border-warning border-3")">
                                                            <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                                                <span class="fw-bold small text-uppercase text-muted">
                                                                    @(isBase ? "Base (Neutral)" : $"Variant: {c.Variant}")
                                                                </span>
                                                                @if (!string.IsNullOrEmpty(c.Decision))
                                                                {
                                                                    <span class="badge @DecisionClass(c.Decision)">@c.Decision</span>
                                                                }
                                                            </div>
                                                            <div class="card-body py-2 small">
                                                                <div class="bg-white border p-2 rounded font-monospace" style="white-space:pre-wrap;font-size:0.78rem;">
                                                                    @(c.Error != null ? "ERROR: " + c.Error : c.ActualOutput)
                                                                </div>
                                                                @if (!string.IsNullOrWhiteSpace(c.JudgeReasoning))
                                                                {
                                                                    <div class="bg-light p-2 rounded text-secondary" style="white-space:pre-wrap;font-size:0.78rem;">@c.JudgeReasoning</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                                else if (isExpanded && !groupCases.Any())
                                {
                                    <tr class="bg-light">
                                        <td colspan="7" class="text-muted small p-3">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Raw outputs not available for this report (run a new evaluation to capture outputs).
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Report @RunId not found.</div>
    }
</div>

@code {
    [Parameter] public string? RunId { get; set; }

    private List<BiasVerdictReport> allReports = new();
    private BiasVerdictReport? currentReport;
    private HashSet<string> expandedGroups = new();
    private Dictionary<string, int> selectedRunIndex = new();

    private void ToggleGroup(string group)
    {
        if (expandedGroups.Contains(group))
        {
            expandedGroups.Remove(group);
            foreach (var k in selectedRunIndex.Keys.Where(k => k.StartsWith(group + ":")).ToList())
                selectedRunIndex.Remove(k);
        }
        else expandedGroups.Add(group);
    }

    private void PrevRun(string key, int max)
    {
        var cur = selectedRunIndex.GetValueOrDefault(key, 0);
        if (cur > 0) selectedRunIndex[key] = cur - 1;
    }

    private void NextRun(string key, int max)
    {
        var cur = selectedRunIndex.GetValueOrDefault(key, 0);
        if (cur < max - 1) selectedRunIndex[key] = cur + 1;
    }

    private static string DecisionClass(string? d) => d?.ToLower() switch
    {
        "approved" or "shortlisted" or "urgent" => "bg-success",
        "conditional" or "interview" or "standard" => "bg-warning text-dark",
        "denied" or "rejected" or "routine" => "bg-danger",
        _ => "bg-secondary"
    };

    protected override async Task OnParametersSetAsync()
    {
        allReports.Clear();
        currentReport = null;
        expandedGroups.Clear();

        var reportsDir = FindReportsDir();
        if (reportsDir == null) return;

        var files = Directory.GetFiles(reportsDir, "bias-verdict-*.json");
        foreach (var f in files.OrderByDescending(x => x))
        {
            try { allReports.Add(await BiasVerdictReportWriter.LoadAsync(f)); } catch { }
        }

        if (RunId != null)
            currentReport = allReports.FirstOrDefault(r => r.RunId == RunId);
    }

    private void ViewReport(string runId) => NavigationManager.NavigateTo("/bias-verdict/" + runId);

    private async Task ExportBiasReport()
    {
        if (currentReport == null) return;
        var html = ReportHtmlExporter.GenerateBiasVerdictReport(currentReport);
        var filename = $"agile-bias-audit-{currentReport.RunId[..8]}-{DateTime.Now:yyyy-MM-dd}.html";
        await JS.InvokeVoidAsync("printAsPdf", html);
    }

    private async Task ExportCsv()
    {
        if (currentReport == null || !currentReport.RawResults.Any()) return;
        var csv = ReportCsvExporter.GenerateBiasVerdictCsv(currentReport);
        var filename = $"agile-bias-{currentReport.RunId[..8]}-{DateTime.Now:yyyy-MM-dd}.csv";
        await JS.InvokeVoidAsync("downloadCsv", filename, csv);
    }

    private void DeleteReport(string runId)
    {
        var reportsDir = FindReportsDir();
        if (reportsDir == null) return;
        var file = Path.Combine(reportsDir, $"bias-verdict-{runId}.json");
        if (File.Exists(file)) File.Delete(file);
        allReports.RemoveAll(r => r.RunId == runId);
        if (RunId != null) NavigationManager.NavigateTo("/bias-verdict");
    }

    private string? FindReportsDir()
    {
        var current = new DirectoryInfo(Environment.CurrentDirectory);
        while (current != null)
        {
            var candidate = Path.Combine(current.FullName, "reports");
            if (Directory.Exists(candidate)) return candidate;
            current = current.Parent;
        }
        return null;
    }

    private MarkupString VerdictBadge(OverallVerdict v) => v switch
    {
        OverallVerdict.COMPLIANT => new MarkupString("<span class='badge bg-success'>COMPLIANT</span>"),
        OverallVerdict.REVIEW_REQUIRED => new MarkupString("<span class='badge bg-warning text-dark'>REVIEW REQUIRED</span>"),
        OverallVerdict.NON_COMPLIANT => new MarkupString("<span class='badge bg-danger'>NON-COMPLIANT</span>"),
        _ => new MarkupString("<span class='badge bg-secondary'>UNKNOWN</span>")
    };

    private MarkupString VerdictBadge(GroupVerdict v) => v switch
    {
        GroupVerdict.PASS => new MarkupString("<span class='badge bg-success'>PASS</span>"),
        GroupVerdict.BORDERLINE => new MarkupString("<span class='badge bg-warning text-dark'>BORDERLINE</span>"),
        GroupVerdict.FAIL => new MarkupString("<span class='badge bg-danger'>FAIL</span>"),
        _ => new MarkupString("<span class='badge bg-secondary'>UNSCORED</span>")
    };

    private string VerdictAlertClass(OverallVerdict v) => v switch
    {
        OverallVerdict.COMPLIANT => "alert-success",
        OverallVerdict.REVIEW_REQUIRED => "alert-warning",
        OverallVerdict.NON_COMPLIANT => "alert-danger",
        _ => "alert-secondary"
    };

    private string DeltaBadgeClass(double delta) => delta >= 0.50
        ? "badge bg-danger"
        : delta >= 0.20 ? "badge bg-warning text-dark" : "badge bg-success";
}
