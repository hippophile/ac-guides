@page "/bias-verdict"
@page "/bias-verdict/{RunId}"
@rendermode InteractiveServer
@using Agile.Core.Models
@using Agile.Core.Reports
@using System.IO
@inject NavigationManager NavigationManager

<PageTitle>Bias Audit | AGILE Platform</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary">Bias Audit Reports</h2>
            <p class="text-muted">Counterfactual fairness evaluations for protected attribute groups.</p>
        </div>
    </div>

    @if (RunId == null)
    {
        <!-- List View -->
        @if (!allReports.Any())
        {
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-muted py-5">
                    <i class="bi bi-shield-exclamation fs-1 mb-3"></i>
                    <h5 class="fw-bold">No bias audit reports found.</h5>
                    <p>Run a counterfactual evaluation to get started.</p>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Run ID</th>
                            <th>Date</th>
                            <th>Model</th>
                            <th>Judge</th>
                            <th>Dataset</th>
                            <th>Overall Verdict</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in allReports)
                        {
                            <tr>
                                <td class="font-monospace small">@r.RunId</td>
                                <td class="small text-muted">@r.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="small">@r.ModelId</td>
                                <td class="small">@r.JudgeModelId</td>
                                <td class="small text-muted">@Path.GetFileName(r.DatasetPath)</td>
                                <td>@VerdictBadge(r.OverallVerdict)</td>
                                <td><a href="/bias-verdict/@r.RunId" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (currentReport != null)
    {
        <!-- Detail View -->
        <div class="mb-3">
            <a href="/bias-verdict" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        </div>

        <!-- Overall Verdict Banner -->
        <div class="alert @VerdictAlertClass(currentReport.OverallVerdict) shadow-sm border-0 mb-4">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-shield-fill me-2"></i>
                Overall Verdict: @currentReport.OverallVerdict
            </h5>
            <div class="mt-2 small">
                Model: <strong>@currentReport.ModelId</strong> &nbsp;|&nbsp;
                Judge: <strong>@currentReport.JudgeModelId</strong> &nbsp;|&nbsp;
                Dataset: <strong>@Path.GetFileName(currentReport.DatasetPath)</strong> &nbsp;|&nbsp;
                Delta Threshold: <strong>@currentReport.DeltaThreshold.ToString("F2")</strong> &nbsp;|&nbsp;
                Run: <span class="font-monospace">@currentReport.RunId</span> &nbsp;|&nbsp;
                @currentReport.Timestamp.ToString("yyyy-MM-dd HH:mm UTC")
            </div>
        </div>

        <!-- Per-Group Table -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Group Results</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Group</th>
                                <th>Base Score</th>
                                <th>Variant Score</th>
                                <th>Delta</th>
                                <th>Verdict</th>
                                <th>Evidence</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in currentReport.Groups)
                            {
                                <tr>
                                    <td class="fw-bold">@g.Group</td>
                                    <td>@g.BaseScore.ToString("F2")</td>
                                    <td>@g.VariantScore.ToString("F2")</td>
                                    <td>
                                        <span class="@DeltaBadgeClass(g.Delta)">@g.Delta.ToString("F3")</span>
                                    </td>
                                    <td>@VerdictBadge(g.Verdict)</td>
                                    <td class="small text-muted">@g.Evidence</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Report @RunId not found.</div>
    }
</div>

@code {
    [Parameter] public string? RunId { get; set; }

    private List<BiasVerdictReport> allReports = new();
    private BiasVerdictReport? currentReport;

    protected override async Task OnParametersSetAsync()
    {
        allReports.Clear();
        currentReport = null;

        var reportsDir = FindReportsDir();
        if (reportsDir == null) return;

        var files = Directory.GetFiles(reportsDir, "bias-verdict-*.json");
        foreach (var f in files.OrderByDescending(x => x))
        {
            try { allReports.Add(await BiasVerdictReportWriter.LoadAsync(f)); } catch { }
        }

        if (RunId != null)
            currentReport = allReports.FirstOrDefault(r => r.RunId == RunId);
    }

    private string? FindReportsDir()
    {
        var current = new DirectoryInfo(Environment.CurrentDirectory);
        while (current != null)
        {
            var candidate = Path.Combine(current.FullName, "reports");
            if (Directory.Exists(candidate)) return candidate;
            current = current.Parent;
        }
        return null;
    }

    private MarkupString VerdictBadge(OverallVerdict v) => v switch
    {
        OverallVerdict.COMPLIANT => new MarkupString("<span class='badge bg-success'>COMPLIANT</span>"),
        OverallVerdict.REVIEW_REQUIRED => new MarkupString("<span class='badge bg-warning text-dark'>REVIEW REQUIRED</span>"),
        OverallVerdict.NON_COMPLIANT => new MarkupString("<span class='badge bg-danger'>NON-COMPLIANT</span>"),
        _ => new MarkupString("<span class='badge bg-secondary'>UNKNOWN</span>")
    };

    private MarkupString VerdictBadge(GroupVerdict v) => v switch
    {
        GroupVerdict.PASS => new MarkupString("<span class='badge bg-success'>PASS</span>"),
        GroupVerdict.BORDERLINE => new MarkupString("<span class='badge bg-warning text-dark'>BORDERLINE</span>"),
        GroupVerdict.FAIL => new MarkupString("<span class='badge bg-danger'>FAIL</span>"),
        _ => new MarkupString("<span class='badge bg-secondary'>UNSCORED</span>")
    };

    private string VerdictAlertClass(OverallVerdict v) => v switch
    {
        OverallVerdict.COMPLIANT => "alert-success",
        OverallVerdict.REVIEW_REQUIRED => "alert-warning",
        OverallVerdict.NON_COMPLIANT => "alert-danger",
        _ => "alert-secondary"
    };

    private string DeltaBadgeClass(double delta) => delta >= 0.10
        ? "badge bg-danger"
        : delta >= 0.05 ? "badge bg-warning text-dark" : "badge bg-success";
}
