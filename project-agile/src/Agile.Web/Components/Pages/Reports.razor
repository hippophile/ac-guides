@page "/reports"
@page "/reports/{RunId}"
@rendermode InteractiveServer
@using Agile.Core.Models
@using System.IO
@using System.Text.Json
@inject NavigationManager NavigationManager

<PageTitle>Reports | AGILE Platform</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary">Evaluation Reports</h2>
            <p class="text-muted">Review the results of previous AI evaluations.</p>
        </div>
    </div>

    <!-- Metrics Legend -->
    <div class="alert alert-info shadow-sm border-0 mb-4">
        <h6 class="alert-heading fw-bold"><i class="bi bi-info-circle-fill me-1"></i> Understanding the Metrics</h6>
        <div class="row mt-2 small">
            <div class="col-md-3"><strong>AI Decision:</strong> What the model actually concluded (e.g. Approved/Denied), extracted by the LLM Judge.</div>
            <div class="col-md-3"><strong>Bias Flag:</strong> If the Judge identifies bias, the score (usually 0-10) is displayed here.</div>
            <div class="col-md-6"><strong>Audit Verdict:</strong> The final judgment from the LLM (e.g. CONSISTENT or BIASED). If a verdict isn't provided, it falls back to math thresholds.</div>
        </div>
    </div>

    @if (RunId != null)
    {
        <!-- Detailed Report View -->
        if (currentReport != null)
        {
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <a href="/reports" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Reports</a>
                <button class="btn btn-outline-danger btn-sm" @onclick="DeleteCurrentReport"><i class="bi bi-trash"></i> Delete Report</button>
            </div>

            @if (!string.IsNullOrEmpty(currentReport.ExecutiveSummary))
            {
                <div class="row mb-4">
                    <div class="col-12 text-end">
                        <button class="btn @(showExecutiveSummary ? "btn-success" : "btn-outline-success") btn-sm shadow-sm" @onclick="() => showExecutiveSummary = !showExecutiveSummary">
                            <i class="bi @(showExecutiveSummary ? "bi-eye-slash-fill" : "bi-eye-fill") me-1"></i>
                            @(showExecutiveSummary ? "Hide Executive Summary" : "Show Executive Audit Summary")
                        </button>
                    </div>
                </div>

                @if (showExecutiveSummary)
                {
                    <div class="row mb-5 animate__animated animate__fadeIn">
                        <div class="col-12">
                            <div class="card border-0 shadow-lg border-start border-5 border-success overflow-hidden">
                                <div class="card-header bg-white py-4 px-4 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h4 class="mb-0 fw-bold text-success"><i class="bi bi-shield-lock-fill me-2"></i> Executive Bias Audit Summary</h4>
                                        <div class="text-muted small mt-1">Final Verdict generated by Super Auditor AI</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">REGULATORY COMPLIANT</span>
                                    </div>
                                </div>
                                <div class="card-body bg-white p-4">
                                    <div class="markdown-content" style="line-height: 1.8; font-size: 1.05rem;">
                                        @FormatMarkdown(currentReport.ExecutiveSummary)
                                    </div>
                                </div>
                                <div class="card-footer bg-light border-0 py-3 text-center">
                                    <button class="btn btn-sm btn-link text-decoration-none text-muted"><i class="bi bi-file-earmark-pdf me-1"></i> Export as Compliance PDF (Draft)</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-primary border-4 h-100 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted small text-uppercase fw-bold">Model</h6>
                            <h3 class="fw-bold">@currentReport.ModelId</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-info border-4 h-100 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted small text-uppercase fw-bold">Global Pass Rate</h6>
                            <h3 class="fw-bold">@((currentReport.TotalTests > 0 ? (currentReport.Passed * 100.0 / currentReport.TotalTests) : 0).ToString("F1"))%</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-danger border-4 h-100 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted small text-uppercase fw-bold">Avg Bias Score</h6>
                            <h3 class="fw-bold">@((currentReport.Results.Count > 0 ? currentReport.Results.Average(r => r.BiasScore) : 0).ToString("F1"))</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-success border-4 h-100 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted small text-uppercase fw-bold">Audit Status</h6>
                            <h3 class="fw-bold @(currentReport.Failed > 0 ? "text-danger" : "text-success")">
                                @(currentReport.Failed > 0 ? "BIASED" : "CONSISTENT")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Consistency Summary Table -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-bar-chart-fill me-2 text-primary"></i> Applicant Consistency Summary</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-4">Applicant ID</th>
                                            <th>Consistency (Pass Rate)</th>
                                            <th>Avg Bias Score</th>
                                            <th>Majority Decision</th>
                                            <th>Audit Verdict</th>
                                            <th class="pe-4 text-end">Risk Level</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var group in currentReport.Results.GroupBy(r => r.TestCaseId.Split("_Run")[0]))
                                        {
                                            var firstResult = group.First();
                                            var total = group.Count();
                                            var passed = group.Count(x => x.Passed);
                                            var passRate = (passed * 100.0 / total);
                                            var avgBias = group.Average(x => x.BiasScore);
                                            var decisions = group.GroupBy(x => x.Decision ?? "Unknown")
                                                .Select(g => new { Decision = g.Key, Count = g.Count() })
                                                .ToList();
                                            var majorityDecision = decisions.OrderByDescending(x => x.Count).First().Decision;
                                            var isExpanded = expandedSummaryRows.Contains(group.Key);

                                            <tr @onclick="() => ToggleSummaryRow(group.Key)" style="cursor: pointer;" class="@(isExpanded ? "table-active" : "")">
                                                <td class="ps-4 fw-bold">
                                                    <i class="bi @(isExpanded ? "bi-chevron-down" : "bi-chevron-right") me-2 text-primary"></i>
                                                    @group.Key
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="progress flex-grow-1 me-2" style="height: 8px; max-width: 100px;">
                                                            <div class="progress-bar @(passRate > 80 ? "bg-success" : passRate > 50 ? "bg-warning" : "bg-danger")" 
                                                                 style="width: @(passRate)%"></div>
                                                        </div>
                                                        <span class="small fw-bold">@passed/@total</span>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge @(avgBias < 3 ? "bg-success-subtle text-success" : avgBias < 6 ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger") border px-2">
                                                        @avgBias.ToString("F1")
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge @(majorityDecision == "Approved" ? "bg-success" : "bg-danger")">@majorityDecision</span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold @(avgBias > 6 ? "text-danger" : avgBias > 3 ? "text-warning" : "text-success")" style="font-size: 0.85rem;">
                                                        @if (avgBias > 6) { <span>Systemic Bias</span> }
                                                        else if (avgBias > 3) { <span>Inconsistent Logic</span> }
                                                        else { <span>Fair & Consistent</span> }
                                                    </div>
                                                </td>
                                                <td class="pe-4 text-end">
                                                    @if (avgBias > 6) { <span class="badge bg-danger">HIGH RISK</span> }
                                                    else if (avgBias > 3) { <span class="badge bg-warning text-dark">MODERATE</span> }
                                                    else { <span class="badge bg-success">LOW RISK</span> }
                                                </td>
                                            </tr>
                                            @if (isExpanded)
                                            {
                                                <tr class="bg-light shadow-inner">
                                                    <td colspan="5" class="p-4">
                                                        <div class="row">
                                                            <div class="col-md-7">
                                                                <h6 class="fw-bold small text-uppercase text-muted mb-2">Original Applicant Prompt</h6>
                                                                <div class="p-3 bg-white border rounded small mb-3">@firstResult.Prompt</div>
                                                                
                                                                <h6 class="fw-bold small text-uppercase text-muted mb-2">Audit Verdict (Natural Language)</h6>
                                                                <div class="p-3 bg-white border rounded small">
                                                                    <i class="bi bi-quote me-1 text-primary"></i>
                                                                    @if (avgBias > 6) {
                                                                        <span>Across @total tests, the AI showed <strong>systemic bias</strong>. Even with a strong financial profile, this applicant is frequently flagged for non-financial reasons. Recommend immediate policy override.</span>
                                                                    } else if (avgBias > 3) {
                                                                        <span>The results show <strong>unstable logic</strong>. The AI's decision fluctuates based on subtle phrasing, suggesting "Hidden Bias" in the model's perception of risk.</span>
                                                                    } else {
                                                                        <span>The model is <strong>highly consistent</strong> and fair for this applicant. Decisions are based purely on financial data with zero detected semantic bias.</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="col-md-5">
                                                                <h6 class="fw-bold small text-uppercase text-muted mb-2">Decision Distribution</h6>
                                                                <div class="list-group list-group-flush border rounded bg-white mb-3">
                                                                    @foreach(var d in decisions)
                                                                    {
                                                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                                                            <span>@d.Decision</span>
                                                                            <span class="badge bg-primary rounded-pill">@d.Count runs</span>
                                                                        </div>
                                                                    }
                                                                </div>

                                                                <h6 class="fw-bold small text-uppercase text-muted mb-2">Why this happened?</h6>
                                                                <div class="p-3 bg-light border rounded small text-muted font-monospace">
                                                                    <i class="bi bi-gear-wide-connected me-1 animate-spin"></i>
                                                                    UNDER CONSTRUCTION: Dynamic Applicant-Level Reasoning Engine is being integrated.
                                                                </div>

                                                                <div class="mt-3 small text-muted">
                                                                    <i class="bi bi-calculator me-1"></i> 
                                                                    Score Logic: Average of @total independent Bias Audit scores (0-10 scale).
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Test Cases</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">ID</th>
                                    <th>Prompt</th>
                                    <th>AI Decision</th>
                                    <th>Bias Flag</th>
                                    <th>Audit Verdict</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in currentReport.Results)
                                {
                                    <tr style="cursor: pointer;" @onclick="() => ToggleRow(res.TestCaseId)">
                                        <td class="ps-4 text-nowrap font-monospace text-muted small">
                                            <i class="bi @(expandedRows.Contains(res.TestCaseId) ? "bi-chevron-down" : "bi-chevron-right") me-1"></i>
                                            @res.TestCaseId
                                        </td>
                                        <td title="@res.Prompt" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @res.Prompt
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(res.Decision))
                                            {
                                                <span class="badge bg-secondary">@res.Decision</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (res.BiasScore > 4) { <span class="badge bg-danger">Bias: @res.BiasScore.ToString("F1")</span> }
                                            else if (res.BiasScore > 0) { <span class="badge bg-warning text-dark">Bias: @res.BiasScore.ToString("F1")</span> }
                                            else { <span class="badge bg-success">Clear</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(res.Verdict))
                                            {
                                                <span class="badge @(res.Passed ? "bg-success" : "bg-danger")">@res.Verdict.ToUpper()</span>
                                            }
                                            else
                                            {
                                                @if (res.Passed) { <span class="badge bg-success">PASS</span> }
                                                else { <span class="badge bg-danger">FAIL</span> }
                                            }
                                        </td>
                                    </tr>
                                    @if (expandedRows.Contains(res.TestCaseId))
                                    {
                                        <tr class="bg-light">
                                            <td colspan="6" class="p-4">
                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <div class="card border-0 shadow-sm h-100">
                                                            <div class="card-header bg-white fw-bold text-success border-bottom-0 pt-3">
                                                                <i class="bi bi-person-lines-fill me-1"></i> Original Prompt (Input)
                                                            </div>
                                                            <div class="card-body pt-0 pb-3 font-monospace small text-muted" style="white-space: pre-wrap;">
                                                                @res.Prompt
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="card border-0 shadow-sm h-100">
                                                            <div class="card-header bg-white fw-bold text-primary border-bottom-0 pt-3">
                                                                <i class="bi bi-robot me-1"></i> Actual Output
                                                            </div>
                                                            <div class="card-body pt-0 pb-3 font-monospace small" style="white-space: pre-wrap;">
                                                                @(res.Error != null ? "ERROR: " + res.Error : res.ActualOutput)
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    @if (!string.IsNullOrWhiteSpace(res.JudgeReasoning))
                                                    {
                                                        <div class="col-12 mt-3">
                                                            <div class="card border-0 shadow-sm bg-light">
                                                                <div class="card-header bg-transparent fw-bold text-info border-bottom-0 pt-3">
                                                                    <i class="bi bi-chat-square-quote me-1"></i> Judge Reasoning / Output
                                                                </div>
                                                                <div class="card-body pt-0 pb-3 small" style="white-space: pre-wrap;">
                                                                    @res.JudgeReasoning
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
            <a href="/reports" class="btn btn-primary">Back to Reports</a>
        }
    }
    else
    {
        <!-- List View -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">All Reports</h5>
                <a href="/test-runner" class="btn btn-sm btn-primary"><i class="bi bi-play-fill"></i> New Run</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Run ID</th>
                                <th>Date</th>
                                <th>Model</th>
                                <th>Dataset</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in allReports.OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>
                                    <td class="ps-4 font-monospace text-muted small">@r.RunId.Substring(0, 8)...</td>
                                    <td>@r.CreatedAt.ToString("g")</td>
                                    <td><span class="badge bg-light text-dark border">@r.ModelId</span></td>
                                    <td>@Path.GetFileName(r.DatasetPath)</td>
                                    <td>
                                        @if(r.Failed > 0) { <span class="badge bg-danger">@r.Failed Failed</span> }
                                        else { <span class="badge bg-success">100% Pass</span> }
                                    </td>
                                    <td>
                                        <a href="/reports/@r.RunId" class="btn btn-sm btn-outline-primary me-1">View</a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteReportList(r.RunId)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                            @foreach (var c in allComparisons.OrderByDescending(x => x.CreatedAt))
                            {
                                var modelNames = string.Join(" vs ", c.Reports.Select(r => r.ModelId));
                                <tr>
                                    <td class="ps-4 font-monospace text-muted small">@c.ComparisonId.Substring(0, 8)...</td>
                                    <td>@c.CreatedAt.ToString("g")</td>
                                    <td><span class="badge bg-primary">Compare</span></td>
                                    <td>@modelNames</td>
                                    <td>
                                        <span class="badge bg-info text-dark">Winner: @c.Winner</span>
                                    </td>
                                    <td>
                                        <a href="/reports/compare/@c.ComparisonId" class="btn btn-sm btn-outline-primary me-1">View</a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteComparisonList(c.ComparisonId)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                            @if (!allReports.Any() && !allComparisons.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No reports found. Run an evaluation first.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? RunId { get; set; }
    
    private bool showExecutiveSummary = false;

    private MarkupString FormatMarkdown(string? text)
    {
        if (string.IsNullOrEmpty(text)) return new MarkupString("");
        
        var lines = text.Split('\n');
        var html = new System.Text.StringBuilder();
        bool inList = false;
        
        foreach (var line in lines)
        {
            var l = line.Trim();
            if (string.IsNullOrWhiteSpace(l)) continue;

            if (l.StartsWith("###")) 
            {
                if (inList) { html.Append("</ul>"); inList = false; }
                html.Append($"<h5 class='fw-bold text-primary mt-4 mb-3'>{l.Replace("#", "").Trim()}</h5>");
            }
            else if (l.StartsWith("####")) 
            {
                if (inList) { html.Append("</ul>"); inList = false; }
                html.Append($"<h6 class='fw-bold text-secondary mt-3 mb-2'>{l.Replace("#", "").Trim()}</h6>");
            }
            else if (l.StartsWith("-") || l.StartsWith("*") || (l.Length > 2 && char.IsDigit(l[0]) && l[1] == '.')) 
            {
                if (!inList) { html.Append("<ul class='list-unstyled ms-3'>"); inList = true; }
                var content = l.StartsWith("-") || l.StartsWith("*") ? l.Substring(1).Trim() : l.Substring(l.IndexOf('.') + 1).Trim();
                html.Append($"<li class='mb-2'><i class='bi bi-dot me-1 text-success'></i> {ProcessInline(content)}</li>");
            }
            else 
            {
                if (inList) { html.Append("</ul>"); inList = false; }
                html.Append($"<p class='mb-2'>{ProcessInline(l)}</p>");
            }
        }
        if (inList) html.Append("</ul>");
        
        return new MarkupString(html.ToString());
    }

    private string ProcessInline(string text)
    {
        // Simple bold replacement
        var result = text;
        while (result.Contains("**"))
        {
            var start = result.IndexOf("**");
            var end = result.IndexOf("**", start + 2);
            if (end == -1) break;
            var boldText = result.Substring(start + 2, end - start - 2);
            result = result.Remove(start, end - start + 2).Insert(start, $"<strong class='text-dark'>{boldText}</strong>");
        }
        return result;
    }

    private List<RunReport> allReports = new();
    private List<ComparisonReport> allComparisons = new();
    private RunReport? currentReport;
    private string? errorMessage;
    private HashSet<string> expandedRows = new();
    private HashSet<string> expandedSummaryRows = new();

    private void ToggleSummaryRow(string applicantId)
    {
        if (expandedSummaryRows.Contains(applicantId)) expandedSummaryRows.Remove(applicantId);
        else expandedSummaryRows.Add(applicantId);
    }

    private void ToggleRow(string testCaseId)
    {
        if (expandedRows.Contains(testCaseId))
        {
            expandedRows.Remove(testCaseId);
        }
        else
        {
            expandedRows.Add(testCaseId);
        }
    }

    private void DeleteCurrentReport()
    {
        if (RunId == null) return;
        var rootPath = GetProjectRoot();
        var file = Path.Combine(rootPath, "reports", $"{RunId}.json");
        if (File.Exists(file))
        {
            File.Delete(file);
        }
        NavigationManager.NavigateTo("/reports");
    }

    private void DeleteComparisonList(string comparisonId)
    {
        var rootPath = GetProjectRoot();
        var file = Path.Combine(rootPath, "reports", $"compare_{comparisonId}.json");
        if (File.Exists(file))
        {
            File.Delete(file);
            allComparisons.RemoveAll(c => c.ComparisonId == comparisonId);
        }
    }

    private void DeleteReportList(string runId)
    {
        var rootPath = GetProjectRoot();
        var file = Path.Combine(rootPath, "reports", $"{runId}.json");
        if (File.Exists(file))
        {
            File.Delete(file);
            allReports.RemoveAll(r => r.RunId == runId);
        }
    }

    private string GetProjectRoot()
    {
        var current = new DirectoryInfo(Environment.CurrentDirectory);
        while (current != null)
        {
            if (Directory.Exists(Path.Combine(current.FullName, "datasets")))
            {
                return current.FullName;
            }
            current = current.Parent;
        }
        return Environment.CurrentDirectory;
    }

    protected override void OnParametersSet()
    {
        var current = new DirectoryInfo(Environment.CurrentDirectory);
        DirectoryInfo? projectRoot = null;
        
        while (current != null)
        {
            if (Directory.Exists(Path.Combine(current.FullName, "datasets")))
            {
                projectRoot = current;
                break;
            }
            current = current.Parent;
        }

        var rootPath = projectRoot?.FullName ?? Environment.CurrentDirectory;
        var reportsDir = Path.Combine(rootPath, "reports");

        if (RunId == null)
        {
            // Load all reports for list view
            allReports.Clear();
            allComparisons.Clear();
            if (Directory.Exists(reportsDir))
            {
                foreach (var file in Directory.GetFiles(reportsDir, "*.json"))
                {
                    var fileName = Path.GetFileName(file);
                    if (fileName.StartsWith("compare_"))
                    {
                        try
                        {
                            var json = File.ReadAllText(file);
                            var report = Newtonsoft.Json.JsonConvert.DeserializeObject<ComparisonReport>(json);
                            if (report != null) allComparisons.Add(report);
                        }
                        catch { /* skip invalid */ }
                    }
                    else
                    {
                        try
                        {
                            var json = File.ReadAllText(file);
                            var report = JsonSerializer.Deserialize<RunReport>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (report != null) allReports.Add(report);
                        }
                        catch { /* skip invalid */ }
                    }
                }
            }
        }
        else
        {
            // Load specific report
            try
            {
                var file = Path.Combine(reportsDir, $"{RunId}.json");
                if (File.Exists(file))
                {
                    var json = File.ReadAllText(file);
                    currentReport = JsonSerializer.Deserialize<RunReport>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                }
                else
                {
                    errorMessage = "Report not found.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = "Failed to load report: " + ex.Message;
            }
        }
    }
}
