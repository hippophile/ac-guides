@page "/quick-audit"
@rendermode InteractiveServer
@using Agile.Core.Models
@using Agile.Core.Reports
@using Agile.Web.Services
@inject QuickAuditRunner Runner
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Quick Audit | AGILE Platform</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary">Quick Bias Audit</h2>
            <p class="text-muted">Describe the AI role to audit — a dataset will be generated and tested automatically.</p>
        </div>
    </div>

    @if (!_isRunning && !_isDone)
    {
        <!-- Setup Form -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Role Description</label>
                    <input type="text" class="form-control" placeholder="e.g. loan officer reviewing applications"
                           @bind="_roleDescription" @bind:event="oninput" />
                    <div class="form-text">Describe what this AI does so the system can generate relevant test cases.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Target Model</label>
                    <input type="text" class="form-control" style="max-width:320px;"
                           @bind="_targetModel" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Bias Dimensions</label>
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAll">Select All</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAll">Clear All</button>
                    </div>
                    <div class="row g-2">
                        @foreach (var dim in AllDimensions)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="dim_@dim"
                                           checked="@_selectedDimensions.Contains(dim)"
                                           @onchange="e => ToggleDimension(dim, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label" for="dim_@dim">@dim.ToString()</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button class="btn btn-primary"
                        disabled="@(!CanRun)"
                        @onclick="StartAudit">
                    <i class="bi bi-lightning-fill me-1"></i> Generate &amp; Run Bias Audit
                </button>
            </div>
        </div>
    }

    @if (_isRunning || _isDone)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-bold">@(_roleDescription)</h5>
            @if (_isRunning)
            {
                <button class="btn btn-outline-danger btn-sm" @onclick="Cancel">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
            }
            else
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="Reset">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> New Audit
                </button>
            }
        </div>

        @if (_isGenerating)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="text-muted">Generating test cases...</span>
                </div>
            </div>
        }

        <!-- Live Dimension Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Dimension Results</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Dimension</th>
                            <th>Status</th>
                            <th>Bias Score</th>
                            <th>Test Cases</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dim in _auditDimensions)
                        {
                            var result = _dimensionResults.GetValueOrDefault(dim);
                            var isRunning = dim == _currentDimension && _isRunning && !_isGenerating;
                            var isClickable = result != null && _savedRunId != null;
                            <tr style="@(isClickable ? "cursor:pointer;" : "")"
                                @onclick="() => NavigateToDimension(isClickable)">
                                <td class="fw-semibold">@dim.ToString()</td>
                                <td>
                                    @if (result != null)
                                    {
                                        @if (result.Status == DimensionStatus.Flagged)
                                        {
                                            <span class="badge bg-danger">&#128308; @(result.BiasScore.ToString("P0")) BIAS</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">&#9989; @result.BiasScore.ToString("P0")</span>
                                        }
                                    }
                                    else if (isRunning)
                                    {
                                        <span class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Running...</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&#9675; Waiting</span>
                                    }
                                </td>
                                <td>
                                    @if (result != null)
                                    {
                                        @if (result.Status == DimensionStatus.Flagged)
                                        {
                                            <span class="fw-bold text-danger">@result.BiasScore.ToString("F3")</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">@result.BiasScore.ToString("F3")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-muted small">@(result?.TestCaseCount.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_isDone && _dimensionResults.Any())
        {
            <!-- Post-Audit Summary -->
            var flaggedCount = _dimensionResults.Values.Count(r => r.Status == DimensionStatus.Flagged);
            var cleanCount = _dimensionResults.Values.Count(r => r.Status == DimensionStatus.Complete);

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">Summary</h6>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-success btn-sm" @onclick="ExportCsv">
                            <i class="bi bi-download me-1"></i> Export CSV
                        </button>
                        @if (_savedRunId != null)
                        {
                            <a href="/bias-verdict/@_savedRunId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-shield-fill me-1"></i> View Full Report
                            </a>
                        }
                        else
                        {
                            <a href="/bias-verdict" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-shield-fill me-1"></i> View Full Reports
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3 text-center">
                                <div class="fs-3 fw-bold text-danger">@flaggedCount</div>
                                <div class="small text-muted text-uppercase">Flagged</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3 text-center">
                                <div class="fs-3 fw-bold text-success">@cleanCount</div>
                                <div class="small text-muted text-uppercase">Clean</div>
                            </div>
                        </div>
                    </div>

                    @foreach (var kv in _dimensionResults.OrderByDescending(r => r.Value.BiasScore))
                    {
                        var pct = (int)Math.Min(kv.Value.BiasScore * 100, 100);
                        var barColor = kv.Value.BiasScore > 0.2 ? "#dc3545" : "#198754";
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@kv.Key.ToString()</span>
                                <span style="color:@barColor">@kv.Value.BiasScore.ToString("P1")</span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar" style="width:@pct%;background:@barColor;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_isCancelled)
        {
            <div class="alert alert-warning">Audit cancelled.</div>
        }
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }
    }
</div>

@code {
    private static readonly BiasDimension[] AllDimensions = Enum.GetValues<BiasDimension>();

    private string _roleDescription = string.Empty;
    private string _targetModel = "gpt-4.1";
    private HashSet<BiasDimension> _selectedDimensions = new(AllDimensions);

    private bool _isRunning;
    private bool _isGenerating;
    private bool _isDone;
    private bool _isCancelled;
    private string _errorMessage = string.Empty;
    private string? _savedRunId;

    private List<BiasDimension> _auditDimensions = new();
    private Dictionary<BiasDimension, QuickAuditDimensionResult> _dimensionResults = new();
    private BiasDimension? _currentDimension;

    private CancellationTokenSource? _cts;

    private bool CanRun => !string.IsNullOrWhiteSpace(_roleDescription) && _selectedDimensions.Any();

    private void SelectAll() => _selectedDimensions = new HashSet<BiasDimension>(AllDimensions);
    private void ClearAll() => _selectedDimensions.Clear();

    private void ToggleDimension(BiasDimension dim, bool isChecked)
    {
        if (isChecked) _selectedDimensions.Add(dim);
        else _selectedDimensions.Remove(dim);
    }

    private async Task StartAudit()
    {
        _cts = new CancellationTokenSource();
        _isRunning = true;
        _isGenerating = true;
        _isDone = false;
        _isCancelled = false;
        _errorMessage = string.Empty;
        _savedRunId = null;
        _auditDimensions = _selectedDimensions.ToList();
        _dimensionResults = new Dictionary<BiasDimension, QuickAuditDimensionResult>();
        _currentDimension = null;

        Runner.OnGenerationComplete = async () =>
        {
            _isGenerating = false;
            _currentDimension = _auditDimensions.FirstOrDefault();
            await InvokeAsync(StateHasChanged);
        };

        int dimensionIndex = 0;
        Runner.OnDimensionComplete = async result =>
        {
            _dimensionResults[result.Dimension] = result;
            dimensionIndex++;
            _currentDimension = dimensionIndex < _auditDimensions.Count ? _auditDimensions[dimensionIndex] : null;
            await InvokeAsync(StateHasChanged);
        };

        var request = new QuickAuditRequest(_roleDescription, _auditDimensions);

        try
        {
            var report = await Task.Run(() => Runner.RunAsync(request, _targetModel, _cts.Token), _cts.Token);
            var reportsDir = FindReportsDir();
            if (reportsDir != null)
            {
                await BiasVerdictReportWriter.SaveAsync(report, reportsDir);
                _savedRunId = report.RunId;
            }
        }
        catch (OperationCanceledException)
        {
            _isCancelled = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isRunning = false;
            _isGenerating = false;
            _isDone = !_isCancelled;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        _cts?.Cancel();
    }

    private void Reset()
    {
        _isRunning = false;
        _isDone = false;
        _isCancelled = false;
        _errorMessage = string.Empty;
        _savedRunId = null;
        _dimensionResults.Clear();
        _auditDimensions.Clear();
        _currentDimension = null;
    }

    private void NavigateToDimension(bool isClickable)
    {
        if (isClickable && _savedRunId != null)
            Nav.NavigateTo("/bias-verdict/" + _savedRunId);
    }

    private string? FindReportsDir()
    {
        var current = new DirectoryInfo(Environment.CurrentDirectory);
        while (current != null)
        {
            var candidate = Path.Combine(current.FullName, "reports");
            if (Directory.Exists(candidate)) return candidate;
            current = current.Parent;
        }
        return null;
    }

    private async Task ExportCsv()
    {
        var bytes = ReportHtmlExporter.ExportQuickAuditCsv(_dimensionResults.Values.ToList());
        var content = System.Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadCsvFile", $"quick-audit-{DateTime.Now:yyyyMMdd-HHmm}.csv", content);
    }
}
